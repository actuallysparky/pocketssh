# LilyGO T-LoRa Pager: 8 MiB QSPI PSRAM.  ESP-IDF names the QSPI transport
# "quad mode"; this must not inherit the T-Deck Plus octal profile.
#
# Keep missing-RAM recovery enabled while bring-up is in progress.  The runtime
# reports the actual detected capacity and falls back to bounded internal-RAM
# scrollback if the PSRAM probe still fails.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# The Pager's native USB interface is USB Serial/JTAG.  Keep it as the
# primary console so boot, PSRAM, and runtime diagnostics use the registered
# USB transport instead of UART0, which is not exposed on the device cable.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Keep Pager boot and runtime health observable over its native USB
# Serial/JTAG console. This target-specific setting leaves the T-Deck's
# production logging policy unchanged.
# CONFIG_LOG_DEFAULT_LEVEL_WARN is not set
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
