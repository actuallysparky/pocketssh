# LilyGO T-LoRa Pager: 8 MiB QSPI PSRAM.  ESP-IDF names the QSPI transport
# "quad mode"; this must not inherit the T-Deck Plus octal profile.
#
# Keep missing-RAM recovery enabled while bring-up is in progress.  The runtime
# reports the actual detected capacity and falls back to bounded internal-RAM
# scrollback if the PSRAM probe still fails.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
